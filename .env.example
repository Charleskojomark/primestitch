# Clerk Authentication Configuration for PrimeStitch
# Obtain these keys from your Clerk Dashboard: https://dashboard.clerk.com -> Select App -> API Keys

# 1. Publishable Key (Public, used by the browser)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# 2. Secret Key (Private, used by server & middleware - keep secret!)
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# 3. Clerk Redirects & Routing URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

